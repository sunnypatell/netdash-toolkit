{
  "name": "netdash-toolkit",
  "version": "3.0.1",
  "private": true,
  "description": "Professional network engineering toolkit with real networking capabilities - featuring subnet calculations, VLSM planning, VLAN management, real ICMP ping, traceroute, and port scanning",
  "author": {
    "name": "Sunny Patel",
    "email": "sunnypatel124555@gmail.com",
    "url": "https://github.com/sunnypatell"
  },
  "license": "MIT",
  "homepage": "https://netdash-toolkit.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/sunnypatell/netdash-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/sunnypatell/netdash-toolkit/issues"
  },
  "keywords": [
    "network",
    "networking",
    "subnet",
    "calculator",
    "vlsm",
    "vlan",
    "ping",
    "traceroute",
    "port-scanner",
    "dns",
    "electron",
    "nextjs",
    "typescript",
    "network-tools",
    "network-engineering",
    "it-tools",
    "devops"
  ],
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "@tailwindcss/oxide",
      "electron-winstaller"
    ],
    "overrides": {
      "flatted": "^3.4.2",
      "js-yaml@^4.0.0": "^4.2.0",
      "minimatch@^3.0.0": "^3.1.3",
      "glob@^10.0.0": "^10.5.0",
      "postcss@^8.0.0": "^8.5.24",
      "protobufjs@^7.0.0": "^7.6.5",
      "sharp@^0.34.0": "^0.35.0",
      "fast-uri@^3.0.0": "^3.1.4",
      "shell-quote@^1.0.0": "^1.9.0",
      "brace-expansion@^5.0.0": "^5.0.8"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "electron:dev": "concurrently \"cross-env NODE_ENV=development next dev\" \"wait-on http://localhost:3000 && tsc -p electron/tsconfig.json && cross-env NODE_ENV=development electron .\"",
    "electron:build": "next build && tsc -p electron/tsconfig.json && electron-builder",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "dist:mac": "pnpm electron:build --mac",
    "dist:win": "pnpm electron:build --win",
    "dist:linux": "pnpm electron:build --linux",
    "dist:all": "pnpm electron:build --mac --win --linux",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.14",
    "@radix-ui/react-alert-dialog": "1.1.17",
    "@radix-ui/react-avatar": "1.2.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.18",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "1.4.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@vercel/analytics": "2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.16.0",
    "lucide-react": "^1.27.0",
    "next": "15.5.21",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serve-handler": "^6.1.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/serve-handler": "^6.1.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "39.8.10",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.21",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "postcss": "^8.5.24",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.10",
    "wait-on": "^9.1.0"
  }
}
