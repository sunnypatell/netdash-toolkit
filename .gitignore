# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# os generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# dependencies
/node_modules
# pnpm repo - keep npm's lockfile out
package-lock.json

# next.js
/.next/
/out/

# docs build artifact: astro output copied here by `pnpm build:docs`,
# then emitted to out/docs/ by next's public/ passthrough
/public/docs/

# docs subproject build output. also listed in docs/.gitignore, but prettier
# only reads the root ignore file and would otherwise check generated html.
/docs/dist/
/docs/.astro/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# electron
/dist-electron
/release
*.dmg
*.exe
*.AppImage
*.deb
*.snap
# vscode - keep extensions.json for contributors
.vscode/*
!.vscode/extensions.json
.env*.local

# browser automation artifacts (belong outside the repo)
.playwright-mcp/
