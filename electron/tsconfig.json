{
  "compilerOptions": {
    "target": "ES2020",
    // node16, not node10: node10 is removed in ts 7, and in commonjs mode node16
    // still resolves extensionless relative imports, so the emit is unchanged
    "module": "node16",
    "moduleResolution": "node16",
    "outDir": "../dist-electron",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules"]
}
